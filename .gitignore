# ── 개인 데이터는 기본으로 올리지 않는다 ──
# 논문 정리·메모·인사이트·질문 기록에는 개인 연구 내용이 들어간다.
# 내 데이터까지 올리고 싶다면(비공개 저장소 권장) 아래 data 줄을 지운다.
data/papers/*.json
data/insights/*.json
data/layout/*.json
data/qa/*.json
!data/**/.gitkeep

# 논문 PDF: 저작권·용량 문제로 올리지 않는다
pdfs/*
!pdfs/.gitkeep

# 백업 파일·비밀 값이 실수로 들어가지 않게
*backup*.json
.env
.env.*
*.key
*.pem
.claude/settings.local.json

# 임시 파일
*.tmp
__pycache__/
.DS_Store
Thumbs.db
